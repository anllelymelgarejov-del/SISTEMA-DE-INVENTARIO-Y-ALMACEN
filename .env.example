# Servidor
PORT=3000
NODE_ENV=development
JWT_SECRET=replace_with_a_long_random_secret

# PostgreSQL local (se usa si DATABASE_URL está vacía)
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=admin123
DB_NAME=sis_inv_almacen
DB_SSL=false

# Base de datos administrada: define DATABASE_URL para usar esta conexión.
# En producción la conexión cloud utiliza SSL.
DATABASE_URL=#

# Opcional: límite del pool al usar DATABASE_URL
# DB_MAX_CONNECTIONS=20
