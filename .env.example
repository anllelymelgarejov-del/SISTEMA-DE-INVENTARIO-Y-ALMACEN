# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - SISTEMA WMS ENTERPRISE
# ==============================================================================

# Entorno de Ejecución (production en Render / development en local)
NODE_ENV=production

# Puerto HTTP del Servidor Express
PORT=3000

# ------------------------------------------------------------------------------
# OPCIÓN A: Conexión Cloud (Recomendada para Render + Supabase)
# Formato: postgresql://postgres:[PASSWORD]@[HOST]:[PORT]/postgres
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.yourprojectid:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# ------------------------------------------------------------------------------
# OPCIÓN B: Conexión Local Desglosada (Solo para desarrollo en localhost)
# ------------------------------------------------------------------------------
DB_USER=postgres
DB_HOST=localhost
DB_NAME=sis_inv_almacen
DB_PASSWORD=tu_password_local
DB_PORT=5432

# ------------------------------------------------------------------------------
# Seguridad y Autenticación JWT
# ------------------------------------------------------------------------------
JWT_SECRET=tu_clave_secreta_jwt_muy_segura_y_aleatoria_2026
JWT_EXPIRES_IN=24h
